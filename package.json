{
  "name": "antigravity-toolkit",
  "displayName": "Antigravity Toolkit",
  "description": "Next-Gen IDE HUD for Google Antigravity: Cyber-Glass quota telemetry, autonomous multi-account rotation, and instant live session switching.",
  "version": "2.0.7",
  "publisher": "antigravity-hub",
  "repository": {
    "type": "git",
    "url": "https://github.com/antigravity-hub/antigravity-toolkit-extension"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Productivity",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "antigravity",
    "gemini",
    "account-switcher",
    "conversation-history",
    "token-monitor",
    "cursor"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-toolkit-sidebar",
          "title": "Antigravity Toolkit",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "antigravity-toolkit-sidebar": [
        {
          "type": "webview",
          "id": "antigravity.views.quota",
          "name": "Antigravity Shield"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravityToolkit.refreshAll",
        "title": "Refresh All",
        "category": "Antigravity Toolkit",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravityToolkit.switchAccount",
        "title": "Switch Account",
        "category": "Antigravity Toolkit",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "antigravityToolkit.addAccount",
        "title": "Add Account",
        "category": "Antigravity Toolkit",
        "icon": "$(add)"
      },
      {
        "command": "antigravityToolkit.syncWithShield",
        "title": "Sync with Antigravity Shield",
        "category": "Antigravity Toolkit",
        "icon": "$(shield)"
      },
      {
        "command": "antigravityToolkit.openConversation",
        "title": "Open Conversation Transcript",
        "category": "Antigravity Toolkit"
      },
      {
        "command": "antigravityToolkit.openQuotaDashboard",
        "title": "Open Full Quota Dashboard",
        "category": "Antigravity Toolkit",
        "icon": "$(dashboard)"
      },
      {
        "command": "antigravityToolkit.toggleAutoSwitch",
        "title": "Toggle Smart Auto-Rotate",
        "category": "Antigravity Toolkit",
        "icon": "$(zap)"
      },
      {
        "command": "antigravityToolkit.triggerAutoRotate",
        "title": "Evaluate & Auto-Rotate Now",
        "category": "Antigravity Toolkit",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravityToolkit.refreshAll",
          "when": "view == antigravity.views.quota",
          "group": "navigation"
        },
        {
          "command": "antigravityToolkit.toggleAutoSwitch",
          "when": "view == antigravity.views.quota",
          "group": "navigation"
        },
        {
          "command": "antigravityToolkit.syncWithShield",
          "when": "view == antigravity.views.quota",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Antigravity Toolkit",
      "properties": {
        "antigravityToolkit.shieldApiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8045",
          "description": "Local Antigravity Shield API base URL."
        },
        "antigravityToolkit.quotaRefreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "description": "Interval in seconds to automatically poll and update quotas."
        },
        "antigravityToolkit.showStatusBarBadge": {
          "type": "boolean",
          "default": true,
          "description": "Show the active account and quota indicator in the IDE status bar."
        },
        "antigravityToolkit.autoSwitch.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically switch to the best standby account when active quota drops below threshold."
        },
        "antigravityToolkit.autoSwitch.quotaThresholdPercent": {
          "type": "number",
          "default": 2,
          "description": "Remaining quota percentage (1-10%) that triggers autonomous account rotation."
        },
        "antigravityToolkit.autoSwitch.cooldownMinutes": {
          "type": "number",
          "default": 3,
          "description": "Cooldown period in minutes between automated switches to prevent rapid oscillation."
        },
        "antigravityToolkit.autoSwitch.notifyOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Display a notification toast when an account is automatically rotated."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && vsce package --no-dependencies",
    "compile": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "^2.30.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0"
  }
}
